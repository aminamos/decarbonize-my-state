{
  "name": "decarb-my-state",
  "private": true,
  "type": "module",
  "description": "A site showing emissions statistics and decarbonization actions state by state",
  "version": "0.1.0",
  "author": "DataMade",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 8000",
    "start": "astro dev --host 0.0.0.0 --port 8000",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 8000",
    "astro": "astro",
    "format": "prettier --write \"src/**/*.{js,jsx,json,md,css}\"",
    "test": "prettier --check \"src/**/*.{js,jsx,json,md,css}\" && vitest run",
    "generate-social-all": "node scripts/generate-social-cards.js",
    "generate-social-states": "node scripts/generate-social-cards.js --states",
    "generate-social-power-plants": "node scripts/generate-social-cards.js --power-plants",
    "test:format": "prettier --check \"src/**/*.{js,jsx,json,md,css}\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.2",
    "bootstrap": "^4.6.2",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-bootstrap": "^1.6.8",
    "react-dom": "^17.0.2",
    "react-scrollspy": "^3.4.3",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^1.19.1",
    "puppeteer": "^23.11.1",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "astro",
    "climate",
    "emissions"
  ],
  "license": "MIT"
}
