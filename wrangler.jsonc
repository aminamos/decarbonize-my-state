{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "decarb-my-state",
  // Set this to today's date
  "compatibility_date": "2026-09-14",
  // Static Astro build output (asset-only Worker, no `main` script).
  // - Astro writes directory-style routes (e.g. /minnesota/index.html);
  //   "drop-trailing-slash" serves /minnesota directly instead of
  //   redirecting /minnesota -> /minnesota/.
  // - Astro emits a 404.html fallback page; serve it for unmatched routes.
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
